{
 "title": "NOVO - Observabilidade Conta-corrente e Clientes",
 "uid": "obs-cc-clientes-v2",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "tags": [
  "observabilidade",
  "golden-signals"
 ],
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "15s",
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Visão geral (SLOs)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Disponibilidade movimentação (15 min) - SLO 99,9%",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "1 - (sum(increase(http_requests_total{operacao=\"movimentacao\",status=~\"5..\"}[15m])) / sum(increase(http_requests_total{operacao=\"movimentacao\"}[15m])))",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.999
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "p99 movimentação (5m)",
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "servico:latencia_p99:5m{operacao=\"movimentacao\"}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.8
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Tráfego total (req/s)",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum(rate(http_requests_total[1m]))",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Alertas disparando",
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "row",
   "title": "Golden signals por operação",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "1. Latência p99 por operação",
   "description": "Percentil 99: mostra a cauda que a média esconde.",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "servico:latencia_p99:5m",
     "legendFormat": "{{servico}} / {{operacao}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "2. Tráfego (req/s) por operação",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum by (servico, operacao) (rate(http_requests_total[1m]))",
     "legendFormat": "{{servico}} / {{operacao}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "3. Erros 5xx (%) por operação",
   "description": "Somente erro técnico. Saldo insuficiente (422) é erro de negócio e não entra aqui.",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "servico:erros_5xx:razao5m",
     "legendFormat": "{{servico}} / {{operacao}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "4. Saturação: pool de conexões (%)",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 6,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "db_pool_em_uso / db_pool_capacidade",
     "legendFormat": "pool {{servico}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    },
    {
     "expr": "http_requests_in_progress / 40",
     "legendFormat": "threads em uso {{servico}}",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "4. Saturação: CPU e memória do processo",
   "description": "",
   "gridPos": {
    "x": 18,
    "y": 14,
    "w": 6,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "processo_cpu_percent",
     "legendFormat": "CPU % {{servico}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    },
    {
     "expr": "processo_memoria_mb",
     "legendFormat": "MB {{servico}}",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 12,
   "type": "row",
   "title": "Métricas de negócio",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Movimentações por tipo e resultado (/min)",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum by (tipo, resultado) (rate(movimentacoes_total[1m])) * 60",
     "legendFormat": "{{tipo}} {{resultado}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Valor movimentado (R$/min)",
   "description": "",
   "gridPos": {
    "x": 8,
    "y": 23,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum by (tipo) (rate(movimentacao_valor_reais_total[1m])) * 60",
     "legendFormat": "{{tipo}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyBRL"
    },
    "overrides": []
   }
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Bloqueios por fraude (por motivo, 5 min)",
   "description": "",
   "gridPos": {
    "x": 16,
    "y": 23,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum by (motivo) (increase(bloqueios_fraude_total[5m]))",
     "legendFormat": "{{motivo}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Contas abertas vs. canceladas (5 min)",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum(increase(contas_abertas_total[5m]))",
     "legendFormat": "abertas",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    },
    {
     "expr": "sum(increase(contas_canceladas_total[5m]))",
     "legendFormat": "canceladas",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Clientes incluídos vs. inativados (5 min)",
   "description": "",
   "gridPos": {
    "x": 8,
    "y": 31,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum(increase(clientes_incluidos_total[5m]))",
     "legendFormat": "incluídos",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    },
    {
     "expr": "sum(increase(clientes_inativados_total[5m]))",
     "legendFormat": "inativados",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Inconsistências cliente x conta (15 min)",
   "description": "Deve ser sempre 0. Valor > 0 = cascata entre serviços falhou.",
   "gridPos": {
    "x": 16,
    "y": 31,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum(increase(inconsistencias_cliente_conta_total[15m]))",
     "legendFormat": "inativações sem cancelamento",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  }
 ],
 "templating": {
  "list": [
   {
    "name": "DS",
    "label": "Fonte de dados",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0
   }
  ]
 }
}